# ── API key 配置（两种方式，二选一）───────────────────────────────────────

# 方式一（推荐）：在 ~/.zshrc 中 export，交互式 shell / tmux 窗格自动继承
#   export DASHSCOPE_API_KEY=sk-...   # Qwen VLM (感知节点用)
#   export DEEPSEEK_API_KEY=sk-...    # DeepSeek (LLM Planner 用)

# 方式二：复制本文件为 .env 并填入，start-demo-mujoco.sh 会 source 它（会覆盖环境变量）
# 注意：.env 已被 .gitignore 忽略，不会提交；.env.example 仅作模板，请勿填入真实 key 再提交。

# Qwen VLM (感知节点用)
DASHSCOPE_API_KEY=sk-your-dashscope-key

# DeepSeek (LLM Planner 用)
DEEPSEEK_API_KEY=sk-your-deepseek-key
